# Google tools of the website. All optional: each one only turns on when its ID is set.
# Nothing loads before the visitor accepts the cookie box. With no ID there is no cookie box.
# In production these come from repository variables (Settings > Secrets and variables > Actions > Variables),
# read by .github/workflows/pages.yml. They are public IDs, not secrets.
# Production uses only GTM, with the GA4 tag inside the container. Do not set both GTM and GA, or visits are counted twice.

# Google Tag Manager: container ID (GTM-XXXXXXX). Tag Manager > Workspace, top right.
VITE_GTM_ID=

# Google Analytics 4: measurement ID (G-XXXXXXXXXX). Only if you do NOT use the GA4 tag inside GTM.
VITE_GA_ID=

# Google Search Console HTML-tag verification (only the content="..." value). Not needed when verified by DNS.
VITE_GSC_VERIFICATION=
